        {"id": "fr-5.1-4-04", "type": "cloze", "fr": "J'ai ___, je voudrais de l'eau.", "a": ["soif"], "hint": "thirst"},
        {"id": "fr-5.1-4-05", "type": "cloze", "fr": "Qu'est-ce que vous ___ ?", "a": ["prenez"], "hint": "prendre"},
        {"id": "fr-5.1-4-06", "type": "build", "en": "I'm hungry and thirsty.", "a": ["J'ai faim et {j'ai |}soif."]},
        {"id": "fr-5.1-4-07", "type": "build", "en": "I'd like a croque-monsieur, please.", "a": ["Je voudrais un croque-monsieur, s'il vous plaît."]},
        {"id": "fr-5.1-4-08", "type": "build", "en": "As a starter I'll have a salad.", "a": ["Comme entrée, {je prends|je voudrais} une salade."]},
        {"id": "fr-5.1-4-09", "type": "build", "en": "What will you have to drink? (vous)", "a": ["{Qu'est-ce que vous prenez|Que prenez-vous|Vous prenez quoi} comme boisson ?"]},
        {"id": "fr-5.1-4-10", "type": "build", "en": "The bill, please.", "a": ["L'addition, s'il vous plaît."]},
        {"id": "fr-5.1-4-11", "type": "build", "en": "I'll have an orange juice, please.", "a": ["{Je prends|Je voudrais} un jus d'orange, s'il vous plaît."]},
        {"id": "fr-5.1-4-12", "type": "transform", "task_en": "Say it more politely", "fr": "Je veux un café.", "a": ["Je voudrais un café."]},
        {"id": "fr-5.1-4-13", "type": "order", "en": "As a main course I'll have chicken and chips.", "a": ["Comme plat je prends du poulet avec des frites"], "extra": ["une", "prend"]}
      ]
    }
  ],
