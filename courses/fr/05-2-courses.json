        {"id": "fr-5.2-2-07", "type": "cloze", "fr": "cinq cents ___ de fromage", "a": ["grammes"], "hint": "grams"},
        {"id": "fr-5.2-2-08", "type": "build", "en": "I'd like a bottle of water.", "a": ["Je voudrais une bouteille d'eau."]},
        {"id": "fr-5.2-2-09", "type": "build", "en": "I'm buying a kilo of apples.", "a": ["J'achète un kilo de pommes."]},
        {"id": "fr-5.2-2-10", "type": "build", "en": "Two slices of ham, please.", "a": ["Deux tranches de jambon, s'il vous plaît."]},
        {"id": "fr-5.2-2-11", "type": "build", "en": "We're buying a packet of pasta.", "a": ["{Nous achetons|On achète} un paquet de pâtes."]},
        {"id": "fr-5.2-2-12", "type": "transform", "task_en": "Add a quantity: un kilo", "fr": "J'achète des tomates.", "a": ["J'achète un kilo de tomates."]},
        {"id": "fr-5.2-2-13", "type": "order", "en": "A bottle of juice and a bar of chocolate.", "a": ["Une bouteille de jus et une tablette de chocolat"], "extra": ["du", "la"]}
