      "learn": [
        {"title": "How much do you want?", "blocks": [
          {"type": "text", "en": "After a quantity or container there's just *de* (*d'*), without an article: *une bouteille d'eau, un kilo de pommes, un paquet de pâtes*."},
          {"type": "table", "textCols": [0], "rows": [
            ["a bottle of water", "une bouteille d'eau"],
            ["a kilo of apples", "un kilo de pommes"],
            ["500 grams of cheese", "cinq cents grammes de fromage"],
            ["a packet of pasta", "un paquet de pâtes"],
            ["a slice of ham", "une tranche de jambon"],
            ["a jar of jam", "un pot de confiture"],
            ["a bar of chocolate", "une tablette de chocolat"],
            ["a tin of tuna", "une boîte de thon"],
            ["litr mléka", "un litre de lait"],
            ["krabice mléka", "une brique de lait"]
          ]},
          {"type": "check", "item": {"type": "cloze", "fr": "un kilo ___ tomates", "a": ["de"]}}
        ]},
        {"title": "On the shopping list", "blocks": [
          {"type": "examples", "items": [
            {"fr": "Je voudrais deux baguettes et un pot de confiture.", "en": "I'd like two baguettes and a jar of jam."},
            {"fr": "J'achète un litre de lait et six œufs.", "en": "I'm buying a litre of milk and six eggs."},
            {"fr": "Trois tranches de jambon, s'il vous plaît.", "en": "Three slices of ham, please."}
          ]}
        ]},
        {"title": "Words", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-5.2-2-01", "type": "cloze", "fr": "une bouteille ___eau", "a": ["d'"]},
