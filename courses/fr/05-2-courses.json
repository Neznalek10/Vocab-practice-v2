        {"id": "fr-5.2-4-04", "type": "cloze", "fr": "Nous ___ venir demain.", "a": ["pouvons"], "hint": "pouvoir"},
        {"id": "fr-5.2-4-05", "type": "cloze", "fr": "On ___ aller au marché ?", "a": ["peut"], "hint": "pouvoir"},
        {"id": "fr-5.2-4-06", "type": "cloze", "fr": "Tu ___ un café ?", "a": ["veux"], "hint": "vouloir"},
        {"id": "fr-5.2-4-07", "type": "build", "en": "What would you like?", "a": ["{Vous désirez|Qu'est-ce que vous désirez} ?"]},
        {"id": "fr-5.2-4-08", "type": "build", "en": "I'd like two croissants, please.", "a": ["Je voudrais deux croissants, s'il vous plaît."]},
        {"id": "fr-5.2-4-09", "type": "build", "en": "Can I pay by card?", "a": ["{Je peux|Est-ce que je peux|Puis-je} payer par carte ?"], "hint": "by card = par carte"},
        {"id": "fr-5.2-4-10", "type": "build", "en": "That's all, thank you.", "a": ["C'est tout, merci."]},
        {"id": "fr-5.2-4-11", "type": "build", "en": "Do you want to go to the market? (tu)", "a": ["{Tu veux|Est-ce que tu veux|Veux-tu} aller au marché ?"]},
        {"id": "fr-5.2-4-12", "type": "build", "en": "I can't, I don't have any money.", "a": ["Je ne peux pas, je n'ai pas d'argent."]},
        {"id": "fr-5.2-4-13", "type": "transform", "task_en": "Change the person to nous", "fr": "Je veux payer.", "a": ["{Nous voulons|On veut} payer."]},
        {"id": "fr-5.2-4-14", "type": "order", "en": "Can you buy some bread? (tu)", "a": ["Tu peux acheter du pain"], "extra": ["veux", "le"]}
      ]
    }
  ],
