    {
      "id": "fr-5.2-3",
      "title": "Ça coûte combien ?",
      "subtitle": "Prices and numbers to 1,000",
      "topics": ["numbers", "shopping"],
      "words": ["shopping#how much is it?", "shopping#euro", "shopping#crown (Czech currency)", "shopping#money", "shopping#cheap", "basics#expensive", "basics#how much, how many", "numbers#a hundred", "numbers#two hundred", "numbers#five hundred", "numbers#a thousand", "numbers#two thousand"],
      "learn": [
        {"title": "Numbers to 1,000", "blocks": [
          {"type": "table", "textCols": [0], "rows": [
            ["100", "cent"], ["101", "cent un"], ["200", "deux cents"], ["250", "deux cent cinquante"],
            ["500", "cinq cents"], ["1000", "mille"], ["2000", "deux mille"]
          ]},
          {"type": "text", "en": "*Cents* only has an *-s* when nothing follows it: *deux cents*, but *deux cent cinquante*. *Mille* never changes: *deux mille*. You don't put *un* before *cent* and *mille*: 100 is *cent*, 1,000 is *mille*."},
          {"type": "check", "item": {"type": "cloze", "fr": "Ça coûte ___ euros.", "a": ["trois cents"], "hint": "300"}}
        ]},
        {"title": "How much is it?", "blocks": [
          {"type": "table", "textCols": [0], "rows": [
            ["How much is it?", "Ça coûte combien ? / C'est combien ?"],
            ["How much is that altogether?", "Ça fait combien ?"],
            ["It costs €2.50.", "Ça coûte deux euros cinquante."],
            ["To je drahé.", "C'est cher."],
            ["To je levné.", "Ce n'est pas cher."]
          ]},
          {"type": "tip", "title": "Cheap", "en": "The French say *pas cher* (not expensive) rather than *bon marché* (cheap)."},
          {"type": "tip", "title": "Prices", "en": "When reading prices you leave out the decimal comma: 3,20 € = *trois euros vingt*."},
          {"type": "check", "item": {"type": "build", "en": "How much is it?", "a": ["{Ça coûte combien|C'est combien|Combien ça coûte} ?"]}}
        ]},
        {"title": "Words", "blocks": [{"type": "vocab"}]}
      ],
      "practice": [
        {"id": "fr-5.2-3-01", "type": "cloze", "fr": "Ça coûte ___ euros.", "a": ["deux cents"], "hint": "200"},
        {"id": "fr-5.2-3-02", "type": "cloze", "fr": "Le vélo coûte ___ euros.", "a": ["trois cent cinquante"], "hint": "350"},
        {"id": "fr-5.2-3-03", "type": "cloze", "fr": "La télé coûte ___ euros.", "a": ["mille"], "hint": "1000"},
        {"id": "fr-5.2-3-04", "type": "cloze", "fr": "L'ordinateur coûte ___ euros.", "a": ["deux mille"], "hint": "2000"},
        {"id": "fr-5.2-3-05", "type": "cloze", "fr": "La baguette coûte un euro ___.", "a": ["vingt"], "hint": "1,20 €"},
        {"id": "fr-5.2-3-06", "type": "build", "en": "How much is the bread?", "a": ["{Le pain coûte combien|Combien coûte le pain|C'est combien, le pain} ?"]},
        {"id": "fr-5.2-3-07", "type": "build", "en": "It costs five euros.", "a": ["{Ça coûte|C'est} cinq euros."]},
        {"id": "fr-5.2-3-08", "type": "build", "en": "That's too expensive!", "a": ["C'est trop cher !"]},
        {"id": "fr-5.2-3-09", "type": "build", "en": "It isn't expensive.", "a": ["Ce n'est pas cher."]},
        {"id": "fr-5.2-3-10", "type": "build", "en": "How much does that make?", "a": ["Ça fait combien ?"]},
        {"id": "fr-5.2-3-11", "type": "order", "en": "The bike costs three hundred euros.", "a": ["Le vélo coûte trois cents euros"], "extra": ["cent", "coûtent"]}
      ]
