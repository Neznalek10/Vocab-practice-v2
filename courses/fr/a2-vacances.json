        "geography#island",
        "geography#forest",
        "geography#campsite",
        "geography#hotel",
        "geography#suitcase",
        "geography#abroad",
        "geography#hike",
        "geography#souvenir",
        "geography#stay",
        "geography#passport",
        "geography#postcard",
        "home#tent",
        "home#sleeping bag",
        "home#camera",
        "transport#airport",
        "transport#ticket",
        "verbs#to travel",
        "verbs#to sunbathe"
      ],
      "learn": [
        {
          "title": "Where are you going?",
          "blocks": [
            {
              "type": "text",
              "en": "On holiday you go *à la mer* (to the seaside), *à la montagne* (to the mountains), *à la campagne* (to the countryside) or *à l'étranger* (abroad). For countries, what you know from A1 applies: *en France, au Portugal, aux États-Unis*."
            },
            {
              "type": "table",
              "textCols": [0],
              "rows": [
                [
                  "to the seaside",
                  "à la mer"
                ],
                [
                  "to the mountains",
                  "à la montagne"
                ],
                [
                  "to the countryside",
                  "à la campagne"
                ],
                [
                  "abroad",
                  "à l'étranger"
                ],
                [
                  "to the beach",
                  "à la plage"
                ],
                [
                  "to an island",
                  "sur une île"
                ]
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Cet été, nous allons ___ la mer.",
                "a": [
                  "à"
                ]
              }
            }
          ]
        },
        {
          "title": "What will you do?",
          "blocks": [
            {
              "type": "text",
              "en": "*Faire du camping* (to go camping), *faire une randonnée* (to go for a hike), *bronzer* (to sunbathe), *se baigner* (to go for a swim), *visiter un musée*, *acheter des souvenirs*, *envoyer une carte postale*."
            },
            {
              "type": "tip",
              "title": "dormir sous la tente",
              "en": "In French you sleep \"under\" a tent: *dormir sous la tente*."
            },
            {
              "type": "examples",
              "items": [
                {
                  "fr": "On fait du camping au bord d'un lac.",
                  "en": "We're camping by a lake."
                },
                {
                  "fr": "Je vais bronzer à la plage.",
                  "en": "I'm going to sunbathe on the beach."
                },
                {
                  "fr": "Nous allons faire une randonnée en montagne.",
                  "en": "We're going to go hiking in the mountains."
                },
                {
                  "fr": "N'oublie pas ton passeport !",
                  "en": "Don't forget your passport!"
                }
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "build",
                "en": "This summer we're going to the mountains.",
                "a": [
                  "Cet été, nous allons à la montagne.",
                  "Cet été, on va à la montagne.",
                  "Cet été, nous irons à la montagne."
                ]
              }
            }
          ]
        },
        {
          "title": "Words",
          "blocks": [
            {
              "type": "vocab"
            }
          ]
        }
      ],
