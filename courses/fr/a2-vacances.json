{
  "schema": 1,
  "goals": [
    "Talk about holidays and travel",
    "The passé composé with être (aller, partir, arriver, rester...)",
    "Participle agreement with the subject: elle est partie",
    "Reflexive verbs in the past: je me suis baigné(e)",
    "Tell the story of your holidays: avoir or être?"
  ],
  "lessons": [
    {
      "id": "fr-vacances-1",
      "title": "Partir en vacances",
      "subtitle": "Holidays and travel",
      "topics": [
        "travel"
      ],
      "words": [
        "school#holidays, vacation",
        "geography#beach",
