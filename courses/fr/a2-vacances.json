    {
      "id": "fr-vacances-2",
      "title": "Je suis allé à la mer",
      "subtitle": "The past with être",
      "topics": [
        "passe-compose-etre"
      ],
      "words": [
        "verbs#to arrive",
        "verbs#to stay",
        "verbs#to fall",
        "verbs#to enter, to go in",
        "verbs#to go up",
