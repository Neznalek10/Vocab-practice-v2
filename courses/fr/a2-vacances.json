    {
      "id": "fr-vacances-4",
      "title": "Je me suis baigné",
      "subtitle": "Reflexive verbs in the past",
      "topics": [
        "passe-compose-etre",
        "reflexive"
      ],
      "words": [
        "verbs-reflexive#to go for a swim",
        "time#during"
      ],
      "learn": [
        {
          "title": "se + être",
          "blocks": [
            {
              "type": "text",
              "en": "All reflexive verbs use *être* in the passé composé. The reflexive pronoun goes before *être*: *je me suis baigné, tu t'es levé, elle s'est reposée*."
            },
            {
              "type": "table",
              "verb": "se baigner",
              "tense": "passe-compose"
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Ce matin, je me ___ levé tôt.",
                "a": [
                  "suis"
                ],
                "hint": "être"
              }
            }
          ]
        },
        {
          "title": "The negative",
          "blocks": [
            {
              "type": "text",
              "en": "*Ne* goes before the pronoun, *pas* after *être*: *Je ne me suis pas baigné.*"
            },
            {
              "type": "examples",
              "items": [
                {
                  "fr": "On s'est bien amusés.",
                  "en": "We had a good time."
                },
                {
                  "fr": "Elle s'est reposée sur la plage.",
                  "en": "She rested on the beach."
                },
                {
                  "fr": "Je ne me suis pas levé tôt.",
                  "en": "I didn't get up early."
                },
                {
                  "fr": "Vous vous êtes baignés dans la mer ?",
                  "en": "Did you swim in the sea? (vous)"
                }
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "transform",
                "task_en": "Make it negative",
                "fr": "Je me suis baigné.",
                "a": [
                  "Je ne me suis pas {baigné|baignée}."
                ]
              }
            }
          ]
        },
        {
          "title": "Words",
          "blocks": [
            {
              "type": "vocab"
            }
          ]
        }
      ],
