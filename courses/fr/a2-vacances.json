    {
      "id": "fr-vacances-3",
      "title": "Elle est partie",
      "subtitle": "Agreement with the subject",
      "topics": [
        "passe-compose-etre"
      ],
      "words": [
        "geography#north",
        "geography#south",
        "geography#east",
        "geography#west"
      ],
      "learn": [
        {
          "title": "Agreement with the subject",
          "blocks": [
            {
              "type": "text",
              "en": "With *être* the participle agrees with the subject like an adjective: feminine *+e*, plural *+s*, feminine plural *+es*."
            },
            {
              "type": "table",
              "textCols": [0],
              "rows": [
                [
                  "he left",
                  "il est parti"
                ],
                [
                  "she left",
                  "elle est partie"
                ],
                [
                  "they left (men or mixed)",
                  "ils sont partis"
                ],
                [
                  "they left (women)",
                  "elles sont parties"
                ]
              ]
            },
            {
              "type": "text",
              "en": "When a girl talks about herself, she writes *je suis allée*. A mixed group of boys and girls is masculine: *Paul et Léa sont partis.*"
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Ma sœur est ___ hier.",
                "a": [
                  "partie"
                ],
                "hint": "partir"
              }
            }
          ]
        },
        {
          "title": "No agreement with avoir",
          "blocks": [
            {
              "type": "tip",
              "title": "no agreement with avoir",
              "en": "With *avoir* the participle doesn't agree with the subject: *Elle a mangé*, not *elle a mangée*."
            },
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Léa est arrivée à midi.",
                  "en": "Léa arrived at noon."
                },
                {
                  "fr": "Mes parents sont restés à la maison.",
                  "en": "My parents stayed at home."
                },
                {
                  "fr": "Mes cousines sont venues avec nous.",
                  "en": "My cousins (girls) came with us."
                },
                {
                  "fr": "Elle a visité le musée.",
                  "en": "She visited the museum."
                }
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "build",
                "en": "My sister stayed at home.",
                "a": [
                  "Ma sœur est restée à la maison."
                ]
              }
            }
          ]
        },
        {
          "title": "Words",
          "blocks": [
            {
              "type": "vocab"
            }
          ]
        }
      ],
