      {"id": "fr-4.1-t-03", "lesson": "fr-4.1-1", "type": "build", "en": "Tomorrow is Wednesday.", "a": ["Demain, {c'est|on est|nous sommes} mercredi."]},
      {"id": "fr-4.1-t-04", "lesson": "fr-4.1-1", "type": "build", "en": "Every Thursday I have English.", "a": ["Le jeudi, j'ai {anglais|cours d'anglais}.", "J'ai {anglais|cours d'anglais} le jeudi."]},
      {"id": "fr-4.1-t-05", "lesson": "fr-4.1-2", "type": "cloze", "fr": "Il est dix heures et ___.", "a": ["demie"], "hint": "10:30"},
      {"id": "fr-4.1-t-06", "lesson": "fr-4.1-2", "type": "cloze", "fr": "Il est deux heures ___ le quart.", "a": ["moins"], "hint": "1:45"},
      {"id": "fr-4.1-t-07", "lesson": "fr-4.1-2", "type": "cloze", "fr": "Il est ___.", "a": ["minuit"], "hint": "0:00"},
      {"id": "fr-4.1-t-08", "lesson": "fr-4.1-2", "type": "build", "en": "It's quarter past two.", "a": ["Il est deux heures et quart."], "hint": "2:15"},
