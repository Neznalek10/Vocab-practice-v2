{
  "schema": 1,
  "goals": [
    "Talk about phones, computers and social media",
    "Say what you like watching and what you think of it",
    "Replace a thing with the pronoun le, la, les",
    "Replace a person with the pronoun lui, leur",
    "Negatives: ne ... jamais, ne ... plus, ne ... rien, ne ... personne"
  ],
