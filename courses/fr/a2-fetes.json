      "learn": [
        {
          "title": "When to use the imparfait",
          "blocks": [
            {
              "type": "text",
              "en": "You use the imparfait for **habits** in the past (*every year, often, always*) and for **descriptions** of what things were like (the weather, a mood, what someone looked like)."
            },
            {
              "type": "table",
              "textCols": [0],
              "rows": [
