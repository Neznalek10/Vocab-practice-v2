                  "I slept",
                  "j'ai dormi"
                ],
                [
                  "I waited",
                  "j'ai attendu"
                ],
                [
                  "I lost",
                  "j'ai perdu"
                ],
                [
                  "I answered",
                  "j'ai répondu"
                ]
