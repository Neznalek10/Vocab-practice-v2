      {"id": "fr-1.2-t-06", "lesson": "fr-1.2-1", "type": "build", "en": "We have a dog.", "a": ["{Nous avons|On a} un chien."], "hint": "dog = un chien"},
      {"id": "fr-1.2-t-07", "lesson": "fr-1.2-2", "type": "cloze", "fr": "J'ai ___ ans.", "a": ["quarante-quatre"], "hint": "44"},
      {"id": "fr-1.2-t-08", "lesson": "fr-1.2-2", "type": "cloze", "fr": "Il a ___ ans.", "a": ["soixante et un", "soixante-et-un"], "hint": "61"},
      {"id": "fr-1.2-t-09", "lesson": "fr-1.2-2", "type": "cloze", "fr": "trente-cinq, trente-six, ___", "a": ["trente-sept"]},
      {"id": "fr-1.2-t-10", "lesson": "fr-1.2-2", "type": "build", "en": "Mrs Martin is fifty.", "a": ["Madame Martin a cinquante ans."]},
      {"id": "fr-1.2-t-11", "lesson": "fr-1.2-3", "type": "cloze", "fr": "Hans est ___.", "a": ["allemand"], "hint": "German (man)"},
      {"id": "fr-1.2-t-12", "lesson": "fr-1.2-3", "type": "cloze", "fr": "Kate et Emma sont ___.", "a": ["anglaises"], "hint": "English (women)"},
      {"id": "fr-1.2-t-13", "lesson": "fr-1.2-3", "type": "transform", "task_en": "Make it feminine", "fr": "Il est américain.", "a": ["Elle est américaine."]},
      {"id": "fr-1.2-t-14", "lesson": "fr-1.2-3", "type": "transform", "task_en": "Make it feminine", "fr": "Il est slovaque.", "a": ["Elle est slovaque."]},
