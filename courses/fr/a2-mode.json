    {
      "id": "fr-mode-2",
      "title": "Je porte un jean",
      "subtitle": "What I wear: porter and mettre",
      "topics": [
        "clothing",
        "mettre"
      ],
      "words": [
        "clothing#glasses",
        "clothing#watch",
        "clothing#gloves",
        "clothing#belt",
        "clothing#scarf",
        "clothing#hat",
        "clothing#handbag",
        "clothing#swimsuit",
        "clothing#leggings",
        "verbs#to wear"
      ],
      "learn": [
        {
          "title": "porter and mettre",
          "blocks": [
            {
              "type": "text",
              "en": "*Porter* = to wear, to have on (a state): *Aujourd'hui, je porte un jean.* *Mettre* = to put on (an action): *Je mets mon manteau et je sors.*"
            },
            {
              "type": "table",
              "verb": "porter",
              "tense": "present"
            },
            {
              "type": "table",
              "verb": "mettre",
              "tense": "present"
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Aujourd'hui, Léa ___ une robe verte.",
                "a": [
                  "porte"
                ],
                "hint": "porter"
              }
            }
          ]
        },
        {
          "title": "Colours and agreement",
          "blocks": [
            {
              "type": "text",
              "en": "A colour goes after the noun and agrees with it: *une jupe noire, des chaussures blanches*. Some colours never change: *marron, orange* (*des chaussures marron*)."
            },
            {
              "type": "tip",
              "title": "s'habiller",
              "en": "*S'habiller* = to get dressed. For a single item of clothing you use *mettre*: *Je mets mes gants.*"
            },
            {
              "type": "check",
              "item": {
                "type": "build",
                "en": "I'm wearing black trousers.",
                "a": [
                  "Je porte un pantalon noir."
                ]
              }
            }
          ]
        },
        {
          "title": "Words",
          "blocks": [
            {
              "type": "vocab"
            }
          ]
        }
      ],
