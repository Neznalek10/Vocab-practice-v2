    {
      "id": "fr-mode-3",
      "title": "Ce pull ou cette veste ?",
      "subtitle": "Demonstratives",
      "topics": [
        "demonstratives",
        "clothing"
      ],
      "words": [
        "clothing#earring",
        "clothing#necklace",
        "clothing#ring",
        "clothing#bracelet",
        "clothing#piece of jewellery",
        "clothing#fashion",
        "clothing#fashionable, in fashion",
        "clothing#elegant",
        "clothing#comfortable"
      ],
      "learn": [
        {
          "title": "this, that, these",
          "blocks": [
            {
              "type": "text",
              "en": "When you point at something (*this jumper, this skirt*), you use *ce, cet, cette, ces*."
            },
            {
              "type": "table",
              "textCols": [0],
              "rows": [
                [
                  "this jumper",
                  "ce pull"
                ],
                [
                  "this friend",
                  "cet ami"
                ],
                [
                  "this skirt",
                  "cette jupe"
                ],
                [
                  "these shoes",
                  "ces chaussures"
                ]
              ]
            },
            {
              "type": "text",
              "en": "*Cet* goes before a masculine word starting with a vowel or a silent *h*: *cet ami, cet hôtel, cet été*. *Ces* is the plural for both genders."
            },
            {
              "type": "check",
              "item": {
                "type": "cloze",
                "fr": "Tu aimes ___ robe ?",
                "a": [
                  "cette"
                ]
              }
            }
          ]
        },
        {
          "title": "-ci and -là",
          "blocks": [
            {
              "type": "text",
              "en": "To tell *this one* and *that one* apart, add *-ci* and *-là*: *ce pull-ci* (this jumper), *ce pull-là* (that jumper). In everyday speech people often just say *-là*."
            },
            {
              "type": "examples",
              "items": [
                {
                  "fr": "Je préfère cette veste-ci.",
                  "en": "I prefer this jacket."
                },
                {
                  "fr": "Ces chaussures-là sont trop chères.",
                  "en": "Those shoes are too expensive."
                },
                {
                  "fr": "Cet été, je vais à la mer.",
                  "en": "This summer I'm going to the seaside."
                },
                {
                  "fr": "Ce collier est très élégant.",
                  "en": "This necklace is very elegant."
                }
              ]
            },
            {
              "type": "check",
              "item": {
                "type": "build",
                "en": "These earrings are pretty.",
                "a": [
                  "Ces boucles d'{oreilles|oreille} sont jolies."
                ]
              }
            }
          ]
        },
        {
          "title": "Words",
          "blocks": [
            {
              "type": "vocab"
            }
          ]
        }
      ],
