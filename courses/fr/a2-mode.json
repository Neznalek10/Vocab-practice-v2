{
  "schema": 1,
  "goals": [
    "Name clothes and accessories",
    "Say what you wear and what you put on (porter, mettre)",
    "Point at things: ce, cet, cette, ces",
    "Compare: plus ... que, moins ... que, aussi ... que, meilleur",
    "Buy clothes: size, trying on, price"
  ],
  "lessons": [
    {
