        {"id": "fr-6-3-13", "type": "build", "en": "Where are my shoes? Under the bed.", "a": ["Où sont mes chaussures ? Sous le lit."]},
        {"id": "fr-6-3-14", "type": "order", "en": "The sofa is opposite the TV.", "a": ["Le canapé est en face de la télé"], "extra": ["du", "dans"]}
      ]
    },
