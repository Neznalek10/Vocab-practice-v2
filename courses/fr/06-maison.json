        {"id": "fr-6-3-09", "type": "build", "en": "The cat is on the bed.", "a": ["Le chat est sur le lit."]},
        {"id": "fr-6-3-10", "type": "build", "en": "The dog is under the table.", "a": ["Le chien est sous la table."]},
        {"id": "fr-6-3-11", "type": "build", "en": "The wardrobe is to the right of the door.", "a": ["L'armoire est à droite de la porte."]},
