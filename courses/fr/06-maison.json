          {"type": "table", "verb": "mettre", "tense": "present"},
          {"type": "text", "en": "*Mettre* means \"to put\", but also \"to put on\" (clothes): *Je mets le livre sur la table. Je mets un pull.*"},
          {"type": "check", "item": {"type": "cloze", "fr": "Je ___ la table.", "a": ["mets"], "hint": "mettre"}}
        ]},
        {"title": "Chores", "blocks": [
